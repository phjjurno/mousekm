{
  "manifest_version": 3,
  "name": "mousekm — 손끝으로 떠나는 전국 여행",
  "version": "0.1.0",
  "description": "크롬 안 어디서든 키보드·마우스 움직임을 실제 거리로 환산해 전국을 여행합니다. 입력 내용은 절대 수집하지 않습니다.",
  "permissions": ["storage"],
  "background": { "service_worker": "bg.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "mousekm — 오늘의 손끝 여행"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mousekm.ws-qf.com/*", "http://localhost:8934/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
